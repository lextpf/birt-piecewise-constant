    <property name="createdBy">io.github.lextpf.birt.chart.piecewiseconstant 1.0.0</property>
    <property name="units">in</property>
    <data-sources>
        <script-data-source name="Piecewise Constant Data Source" id="2"/>
    </data-sources>
    <data-sets>
        <script-data-set name="Piecewise Constant Data Set" id="3">
            <!-- The ROM knows no "resultSet" property on script-data-set (it lives on
                 oda-data-set and joint-data-set only); "resultSetHints" is the column
                 metadata a scripted data set declares. -->
            <list-property name="resultSetHints">
                <structure>
                    <property name="position">1</property>
                    <property name="name">category</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">value</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">category</property>
                </structure>
                <structure>
                    <property name="columnName">value</property>
                </structure>
            </list-property>
            <property name="dataSource">Piecewise Constant Data Source</property>
            <method name="open"><![CDATA[i = 0;
categories = [ "A", "B", "C", "D", "E" ];
values = [ 12.5, 19.6, 18.3, 13.2, 26.5 ];]]></method>
            <method name="fetch"><![CDATA[if ( i < 5 )
{
	row["category"] = categories[i];
	row["value"] = values[i];
	i++;
	return true;
}
return false;]]></method>
        </script-data-set>
    </data-sets>
    <page-setup>
        <simple-master-page name="Simple MasterPage" id="4"/>
    </page-setup>
