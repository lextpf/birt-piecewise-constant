# Copy to .env (git-ignored) or run .\setup.ps1 — build.ps1 reads this file.
# JDK 21 installation root (must contain bin\java.exe; BIRT 4.24 needs Java 21)
JAVA_HOME=C:\Path\To\jdk-21
# Apache Maven 3.9.x installation root (must contain bin\mvn.cmd)
MAVEN_HOME=C:\Path\To\apache-maven-3.9.x
# Optional: unpacked birt-runtime-4.24.0 (folder that contains ReportEngine\lib); enables RuntimeSmokeIT
BIRT_RUNTIME_DIR=
