# build.ps1 reads .env. Copy this file to .env, or run .\setup.ps1. Git ignores .env.
# JDK 21 installation root. It must contain bin\java.exe. BIRT 4.24 needs Java 21.
JAVA_HOME=C:\Path\To\jdk-21
# Apache Maven 3.9.x installation root. It must contain bin\mvn.cmd.
MAVEN_HOME=C:\Path\To\apache-maven-3.9.x
# Optional: the unpacked birt-runtime-4.24.0 folder that contains ReportEngine\lib.
# A path here enables RuntimeSmokeIT. An empty value keeps that test skipped.
BIRT_RUNTIME_DIR=
