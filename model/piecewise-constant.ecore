<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="piecewiseconstant"
    nsURI="http://lextpf.github.io/birt/chart/PiecewiseConstantModelType" nsPrefix="piecewise">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="The schema of the piecewise constant chart model package. The package holds one series type and one enumeration. The chart engine reads and writes the series of a chart with this schema."/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="PiecewiseConstantSeries" eSuperTypes="http://www.birt.eclipse.org/ChartModelType#//LineSeries">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A series type for a piecewise constant chart. It holds the query at design time, and the value of each data point at run time. The renderer joins two consecutive data points with a tread and a step instead of a direct line. The plotted function therefore stays constant between two data points."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="PiecewiseConstantSeries"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stepMode" eType="#//StepMode"
        defaultValueLiteral="After" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="States where the renderer puts the step between two consecutive values. The default value is After. The serializer writes this element only when a caller sets the attribute."/>
      </eAnnotations>
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="StepMode"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="StepMode">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The possible positions of the step between two data points. After holds each value until the position of the next point. Before takes the value of a point already at the position of the previous point. Center puts the step halfway between the two points."/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="StepMode"/>
    </eAnnotations>
    <eLiterals name="After"/>
    <eLiterals name="Before" value="1"/>
    <eLiterals name="Center" value="2"/>
  </eClassifiers>
</ecore:EPackage>
